{
  "_comment": "模块默认配置 - 真实部署时会在 /sdcard/picoclaw/config.json 创建用户配置。请填入真实 API key 等敏感信息,不要提交到 git",
  "session": {
    "dm_scope": "per-channel-peer"
  },
  "version": 1,
  "agents": {
    "defaults": {
      "workspace": "/sdcard/picoclaw/workspace",
      "restrict_to_workspace": false,
      "allow_read_outside_workspace": false,
      "provider": "minimax",
      "model_name": "MiniMax-M2.7",
      "max_tokens": 200000,
      "max_tool_iterations": 50
    }
  },
  "channels": {
    "feishu": {
      "enabled": false,
      "app_id": "",
      "app_secret": "",
      "allow_from": []
    },
    "qq": {
      "enabled": false,
      "app_id": "",
      "app_secret": "",
      "allow_from": []
    },
    "pico": {
      "enabled": true,
      "ping_interval": 30,
      "read_timeout": 60,
      "write_timeout": 10,
      "max_connections": 100
    }
  },
  "model_list": [
    {
      "name": "minimax",
      "model_name": "MiniMax-M2.7",
      "model": "MiniMax-M2.7",
      "api_base": "https://api.minimaxi.com/v1",
      "api_key": "PLEASE_FILL_YOUR_API_KEY"
    }
  ],
  "gateway": {
    "host": "0.0.0.0",
    "port": 18790
  },
  "tools": {
    "web": {
      "enabled": true
    },
    "exec": {
      "enabled": true
    },
    "write_file": {
      "enabled": true
    }
  },
  "heartbeat": {
    "enabled": false
  }
}
